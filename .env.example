# Example .env file for local development
# Copy this to .env (not committed) and replace the placeholder with your real key.

# Groq API key (DO NOT COMMIT the real key)
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=your-groq-api-key-here
# Other example variables:
# LOG_LEVEL=info
# EXTRA_TIMEOUT=30