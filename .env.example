# Example .env file for local development
# Copy this to .env (not committed) and replace the placeholder with your real key.

# Groq API key (DO NOT COMMIT the real key)
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=your-groq-api-key-here
# Mistral API key (DO NOT COMMIT the real key)
MISTRAL_API_KEY=your-mistral-api-key-here
# Cloudflare API credentials (DO NOT COMMIT the real credentials)
CF_ACCOUNT_ID=your-cloudflare-account-id-here
CF_AUTH_TOKEN=your-cloudflare-auth-token-here
# Google Gemini API key (DO NOT COMMIT the real key)
GEMINI_API_KEY=your-google-gemini-api-key-here